# What the Composer dist (a git archive of the tag) leaves out: the
# TypeScript engine, the tests, the fixtures and the tooling. It ships
# composer.json, php/src, meta/ (which php/src reads), docs/, README.md,
# CHANGELOG.md and LICENSE. npm ships what package.json's `files` lists.
/.claude export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.nvmrc export-ignore
/composer.lock export-ignore
/fixtures export-ignore
/package.json export-ignore
/php/tests export-ignore
/phpunit.xml.dist export-ignore
/pnpm-lock.yaml export-ignore
/pnpm-workspace.yaml export-ignore
/scripts export-ignore
/src export-ignore
/test export-ignore
/tsconfig.build.json export-ignore
/tsconfig.cli.json export-ignore
/tsconfig.json export-ignore
/vitest.config.ts export-ignore
