{
    "description": "What ThemeUpgrades answers for each theme or site's settings between bases made from marketplace_website@26.0.",
    "php": "8.3.35",
    "schemas": {
        "26": [
            [
                "set",
                [
                    "version"
                ],
                "26.4.0"
            ],
            [
                "set",
                [
                    "components",
                    "button",
                    "base",
                    "old_gap"
                ],
                {
                    "$type": "dimension",
                    "$value": "{space.sm}",
                    "$extensions": {
                        "co.ordering": {
                            "scale": "space"
                        }
                    }
                }
            ],
            [
                "set",
                [
                    "components",
                    "link",
                    "base",
                    "underline",
                    "$extensions",
                    "co.ordering",
                    "options"
                ],
                [
                    "none",
                    "hover",
                    "underlined"
                ]
            ],
            [
                "set",
                [
                    "components",
                    "card",
                    "base",
                    "padding"
                ],
                {
                    "$type": "dimension",
                    "$value": "{size.lg}",
                    "$extensions": {
                        "co.ordering": {
                            "scale": "size"
                        }
                    }
                }
            ],
            [
                "set",
                [
                    "components",
                    "modal",
                    "base",
                    "padding"
                ],
                {
                    "$type": "dimension",
                    "$value": "{space.lg}",
                    "$extensions": {
                        "co.ordering": {
                            "scale": "space"
                        }
                    }
                }
            ],
            [
                "set",
                [
                    "tokens",
                    "color",
                    "brand"
                ],
                {
                    "$value": "#E4002B"
                }
            ],
            [
                "set",
                [
                    "tokens",
                    "typography",
                    "small"
                ],
                {
                    "$value": {
                        "size": 11,
                        "line": 1.4,
                        "weight": 400
                    }
                }
            ],
            [
                "set",
                [
                    "visibility",
                    "header.brand"
                ],
                {
                    "$value": true
                }
            ],
            [
                "set",
                [
                    "visibility",
                    "old_banner"
                ],
                {
                    "$value": false
                }
            ],
            [
                "set",
                [
                    "pages",
                    "shop"
                ],
                {
                    "footer": {
                        "$type": "boolean",
                        "$value": null,
                        "$extensions": {
                            "co.ordering.editor": {
                                "label": {
                                    "key": "BUILDER_THEME_PAGE_FOOTER",
                                    "default": "Footer"
                                },
                                "info": {
                                    "key": "BUILDER_THEME_PAGE_FOOTER_HELP",
                                    "default": "Whether this page ends with the footer. The whole website’s choice is in Visibility."
                                },
                                "control": "segmented",
                                "order": 1,
                                "platform": {
                                    "info": {
                                        "key": "BUILDER_THEME_PAGE_FOOTER_PLATFORM_HELP",
                                        "default": "Whether this page ends with the footer on phones."
                                    }
                                },
                                "options": [
                                    {
                                        "value": null,
                                        "label": {
                                            "key": "BUILDER_THEME_FOOTER_AS_SITE",
                                            "default": "As on the whole website (_state_)",
                                            "params": {
                                                "_state_": [
                                                    {
                                                        "key": "BUILDER_THEME_SHOWN",
                                                        "default": "shown"
                                                    },
                                                    {
                                                        "key": "BUILDER_THEME_HIDDEN",
                                                        "default": "hidden"
                                                    }
                                                ]
                                            }
                                        },
                                        "label_platform": {
                                            "key": "BUILDER_THEME_FOOTER_AS_ALL_SCREENS",
                                            "default": "As on all screens (_state_)",
                                            "params": {
                                                "_state_": [
                                                    {
                                                        "key": "BUILDER_THEME_SHOWN",
                                                        "default": "shown"
                                                    },
                                                    {
                                                        "key": "BUILDER_THEME_HIDDEN",
                                                        "default": "hidden"
                                                    }
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "value": true,
                                        "label": {
                                            "key": "BUILDER_THEME_SHOW",
                                            "default": "Show"
                                        }
                                    },
                                    {
                                        "value": false,
                                        "label": {
                                            "key": "BUILDER_THEME_HIDE",
                                            "default": "Hide"
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "sections": {
                        "$type": "sections",
                        "$value": [],
                        "$extensions": {
                            "co.ordering.editor": {
                                "label": {
                                    "key": "BUILDER_THEME_PAGE_SECTIONS",
                                    "default": "Sections"
                                },
                                "info": {
                                    "key": "BUILDER_THEME_PAGE_NO_SECTIONS",
                                    "default": "This page has no sections to move or hide."
                                },
                                "control": "sortable_sections",
                                "order": 2
                            }
                        }
                    },
                    "$extensions": {
                        "co.ordering.editor": {
                            "label": {
                                "key": "BUILDER_THEME_PAGE_MULTI_CART",
                                "default": "Carts of several stores"
                            },
                            "group": "order",
                            "order": 3,
                            "preview": {
                                "page": "multi_cart",
                                "path": "/multi-cart"
                            }
                        }
                    }
                }
            ],
            [
                "set",
                [
                    "site",
                    "slug"
                ],
                {
                    "$type": "string",
                    "$value": ""
                }
            ],
            [
                "set",
                [
                    "site",
                    "legacy_flag"
                ],
                {
                    "$type": "boolean",
                    "$value": false
                }
            ],
            [
                "delete",
                [
                    "site",
                    "description"
                ]
            ],
            [
                "set",
                [
                    "$extensions",
                    "co.ordering.migrate"
                ],
                [
                    {
                        "from": "components.card.base.corner",
                        "to": "components.card.base.radius"
                    }
                ]
            ]
        ],
        "27": [
            [
                "set",
                [
                    "version"
                ],
                "27.0.0"
            ],
            [
                "set",
                [
                    "$extensions",
                    "co.ordering.upgrade"
                ],
                {
                    "from": 26,
                    "moves": [
                        {
                            "from": "components.button.base.old_gap",
                            "to": "components.button.base.icon_gap"
                        },
                        {
                            "from": "components.link.base.underline",
                            "to": "components.link.base.underline",
                            "map": {
                                "none": "none",
                                "hover": "hover",
                                "underlined": "always"
                            }
                        },
                        {
                            "from": "components.card.base.padding",
                            "to": "components.card.base.padding",
                            "map": {
                                "{size.lg}": "{space.lg}",
                                "{size.md}": "{space.md}"
                            }
                        },
                        {
                            "from": "tokens.color.brand",
                            "to": "tokens.color.primary"
                        },
                        {
                            "from": "visibility.header.brand",
                            "to": "visibility.header.logo"
                        },
                        {
                            "from": "pages.shop",
                            "to": "pages.multi_cart"
                        },
                        {
                            "from": "site.slug",
                            "to": "site.business_slug"
                        }
                    ],
                    "drop": [
                        "visibility.old_banner",
                        "site.legacy_flag"
                    ],
                    "rewrite": {
                        "id": "test.bolder",
                        "paths": [
                            "tokens.typography.small"
                        ]
                    }
                }
            ]
        ],
        "28": [
            [
                "set",
                [
                    "version"
                ],
                "28.0.0"
            ],
            [
                "delete",
                [
                    "components",
                    "button",
                    "base",
                    "icon_gap"
                ]
            ],
            [
                "set",
                [
                    "components",
                    "button",
                    "base",
                    "icon_space"
                ],
                {
                    "$type": "dimension",
                    "$value": "{space.sm}",
                    "$extensions": {
                        "co.ordering": {
                            "scale": "space"
                        }
                    }
                }
            ],
            [
                "set",
                [
                    "$extensions",
                    "co.ordering.upgrade"
                ],
                {
                    "from": 27,
                    "moves": [
                        {
                            "from": "components.button.base.icon_gap",
                            "to": "components.button.base.icon_space"
                        }
                    ],
                    "drop": []
                }
            ]
        ]
    },
    "cases": [
        {
            "name": "identity",
            "description": "What keeps its path and kind keeps its value: a color, a component property, a footer, a platform's override, a visibility key, an image.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "tokens": {
                    "color": {
                        "primary": "#2C7BE5"
                    }
                },
                "components": {
                    "card": {
                        "base": {
                            "background": "{color.surface}"
                        }
                    }
                },
                "pages": {
                    "home": {
                        "footer": false
                    }
                },
                "visibility": {
                    "footer": false
                },
                "images": {
                    "logo": "https://example.com/logo.png"
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "modal": {
                                "base": {
                                    "radius": "{radius.xl}"
                                }
                            }
                        }
                    }
                }
            },
            "expected": {
                "tokens": {
                    "color": {
                        "primary": "#2C7BE5"
                    }
                },
                "components": {
                    "card": {
                        "base": {
                            "background": "{color.surface}"
                        }
                    }
                },
                "pages": {
                    "home": {
                        "footer": false
                    }
                },
                "visibility": {
                    "footer": false
                },
                "images": {
                    "logo": "https://example.com/logo.png"
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "modal": {
                                "base": {
                                    "radius": "{radius.xl}"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "moves",
            "description": "Moves: a property (and a platform's override of it), a visibility key (and a platform's), a whole page and a key the previous base's own migration moved first (the card's `corner`, its radius since 26.4).",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "components": {
                    "button": {
                        "base": {
                            "old_gap": "{space.md}"
                        }
                    },
                    "card": {
                        "base": {
                            "corner": "{radius.xl}"
                        }
                    }
                },
                "visibility": {
                    "header.brand": false
                },
                "pages": {
                    "shop": {
                        "footer": false,
                        "sections": [
                            {
                                "key": "items",
                                "visible": true
                            }
                        ]
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "button": {
                                "base": {
                                    "old_gap": "{space.xs}"
                                }
                            }
                        },
                        "visibility": {
                            "header.brand": true
                        }
                    }
                }
            },
            "expected": {
                "components": {
                    "card": {
                        "base": {
                            "radius": "{radius.xl}"
                        }
                    },
                    "button": {
                        "base": {
                            "icon_gap": "{space.md}"
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "button": {
                                "base": {
                                    "icon_gap": "{space.xs}"
                                }
                            }
                        },
                        "visibility": {
                            "header.logo": true
                        }
                    }
                },
                "visibility": {
                    "header.logo": false
                },
                "pages": {
                    "multi_cart": {
                        "footer": false,
                        "sections": []
                    }
                }
            }
        },
        {
            "name": "moves-to-set",
            "description": "A move to a key the theme already sets in the new base's name does not overwrite it; `from` goes either way.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "visibility": {
                    "header.brand": false,
                    "header.logo": true
                },
                "tokens": {
                    "color": {
                        "brand": "#E4002B",
                        "primary": "#000000"
                    }
                }
            },
            "expected": {
                "visibility": {
                    "header.logo": true
                },
                "tokens": {
                    "color": {
                        "primary": "#000000"
                    }
                }
            }
        },
        {
            "name": "map",
            "description": "Maps: an option renamed (`underlined` is `always`) and a scale changed (`{size.lg}` is `{space.lg}`), also on a platform; a level the map does not name, and a number, are dropped.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "components": {
                    "link": {
                        "base": {
                            "underline": "underlined"
                        }
                    },
                    "card": {
                        "base": {
                            "padding": "{size.lg}"
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "card": {
                                "base": {
                                    "padding": "{size.sm}"
                                }
                            },
                            "link": {
                                "base": {
                                    "underline": "none"
                                }
                            }
                        }
                    }
                }
            },
            "expected": {
                "components": {
                    "link": {
                        "base": {
                            "underline": "always"
                        }
                    },
                    "card": {
                        "base": {
                            "padding": "{space.lg}"
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "link": {
                                "base": {
                                    "underline": "none"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "map-number",
            "description": "A number where a map translates levels is dropped: the map names only what it translates.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "components": {
                    "card": {
                        "base": {
                            "padding": 12
                        }
                    }
                }
            },
            "expected": []
        },
        {
            "name": "token-aliases",
            "description": "A color moved: its value, its value in dark mode and every alias to it (a property, a border's color, a platform's override) name the new one.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "tokens": {
                    "color": {
                        "brand": "#E4002B"
                    }
                },
                "modes": {
                    "dark": {
                        "color": {
                            "brand": "#FF5A5F"
                        }
                    }
                },
                "components": {
                    "card": {
                        "base": {
                            "background": "{color.brand}",
                            "border": {
                                "width": 1,
                                "color": "{color.brand}"
                            }
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "modal": {
                                "base": {
                                    "background": "{color.brand}"
                                }
                            }
                        }
                    }
                }
            },
            "expected": {
                "components": {
                    "card": {
                        "base": {
                            "background": "{color.primary}",
                            "border": {
                                "width": 1,
                                "color": "{color.primary}"
                            }
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "modal": {
                                "base": {
                                    "background": "{color.primary}"
                                }
                            }
                        }
                    }
                },
                "tokens": {
                    "color": {
                        "primary": "#E4002B"
                    }
                },
                "modes": {
                    "dark": {
                        "color": {
                            "primary": "#FF5A5F"
                        }
                    }
                }
            }
        },
        {
            "name": "type-changed",
            "description": "A property whose type changed at the same path (the modal's padding, a level of space in 26, a number in 27) and no move takes: dropped, though 24 would fit both, also on a platform.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "components": {
                    "modal": {
                        "base": {
                            "padding": 24,
                            "radius": "{radius.sm}"
                        }
                    }
                },
                "platforms": {
                    "mobile_web": {
                        "components": {
                            "modal": {
                                "base": {
                                    "padding": 16
                                }
                            }
                        }
                    }
                }
            },
            "expected": {
                "components": {
                    "modal": {
                        "base": {
                            "radius": "{radius.sm}"
                        }
                    }
                }
            }
        },
        {
            "name": "drop",
            "description": "Drops: a visibility key, and a platform's override of it.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "visibility": {
                    "old_banner": true,
                    "footer": true
                },
                "platforms": {
                    "mobile_web": {
                        "visibility": {
                            "old_banner": false
                        }
                    }
                }
            },
            "expected": {
                "visibility": {
                    "footer": true
                }
            }
        },
        {
            "name": "rewrite",
            "description": "The rewrite the base names, passed: the typography `small` becomes `caption` and every weight goes up a step.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": true,
            "values": {
                "tokens": {
                    "typography": {
                        "small": {
                            "size": 11,
                            "line": 1.4,
                            "weight": 400
                        },
                        "h1": {
                            "size": 30,
                            "line": 1.2,
                            "weight": 600
                        }
                    }
                }
            },
            "expected": {
                "tokens": {
                    "typography": {
                        "h1": {
                            "size": 30,
                            "line": 1.2,
                            "weight": 700
                        },
                        "caption": {
                            "size": 11,
                            "line": 1.4,
                            "weight": 500
                        }
                    }
                }
            }
        },
        {
            "name": "rewrite-skipped",
            "description": "The same theme without the rewrite: `small`, which 27 does not name, is dropped, and the weights stay.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": {
                "tokens": {
                    "typography": {
                        "small": {
                            "size": 11,
                            "line": 1.4,
                            "weight": 400
                        },
                        "h1": {
                            "size": 30,
                            "line": 1.2,
                            "weight": 600
                        }
                    }
                }
            },
            "expected": {
                "tokens": {
                    "typography": {
                        "h1": {
                            "size": 30,
                            "line": 1.2,
                            "weight": 600
                        }
                    }
                }
            }
        },
        {
            "name": "chain",
            "description": "Through 27 to 28: the button's gap is `old_gap` in 26, `icon_gap` in 27 and `icon_space` in 28; the rest of each step as before, the rewrite once.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27",
                "28"
            ],
            "rewrite": true,
            "values": {
                "components": {
                    "button": {
                        "base": {
                            "old_gap": "{space.md}"
                        }
                    },
                    "link": {
                        "base": {
                            "underline": "underlined"
                        }
                    },
                    "card": {
                        "base": {
                            "background": "{color.brand}"
                        }
                    }
                },
                "tokens": {
                    "color": {
                        "brand": "#E4002B"
                    },
                    "typography": {
                        "h2": {
                            "size": 24,
                            "line": 1.3,
                            "weight": 500
                        }
                    }
                },
                "visibility": {
                    "old_banner": true
                }
            },
            "expected": {
                "components": {
                    "card": {
                        "base": {
                            "background": "{color.primary}"
                        }
                    },
                    "link": {
                        "base": {
                            "underline": "always"
                        }
                    },
                    "button": {
                        "base": {
                            "icon_space": "{space.md}"
                        }
                    }
                },
                "tokens": {
                    "typography": {
                        "h2": {
                            "size": 24,
                            "line": 1.3,
                            "weight": 600
                        }
                    },
                    "color": {
                        "primary": "#E4002B"
                    }
                }
            }
        },
        {
            "name": "one-schema",
            "description": "A chain of one schema: what of the theme fits it.",
            "kind": "upgrade",
            "bases": [
                "27"
            ],
            "rewrite": false,
            "values": {
                "components": {
                    "button": {
                        "base": {
                            "old_gap": "{space.md}",
                            "radius": "{radius.sm}"
                        }
                    }
                }
            },
            "expected": {
                "components": {
                    "button": {
                        "base": {
                            "radius": "{radius.sm}"
                        }
                    }
                }
            }
        },
        {
            "name": "list",
            "description": "A list is no theme.",
            "kind": "upgrade",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": false,
            "values": [
                1
            ],
            "expected": []
        },
        {
            "name": "settings",
            "description": "A site's settings: a setting moved, one dropped, one the new base does not take (an option it has not), and one that stays.",
            "kind": "settings",
            "bases": [
                "26",
                "27"
            ],
            "rewrite": true,
            "values": {
                "slug": "my-shop",
                "legacy_flag": true,
                "mode": "kiosk",
                "name": "My shop"
            },
            "expected": {
                "name": "My shop",
                "business_slug": "my-shop"
            }
        },
        {
            "name": "settings-chain",
            "description": "The same settings through 28.",
            "kind": "settings",
            "bases": [
                "26",
                "27",
                "28"
            ],
            "rewrite": false,
            "values": {
                "slug": "my-shop",
                "business_slug": "kept",
                "third_party_code": {
                    "head": "<meta>"
                }
            },
            "expected": {
                "business_slug": "kept",
                "third_party_code": {
                    "head": "<meta>"
                }
            }
        },
        {
            "name": "cut-down",
            "description": "A theme of 27 for a client of 26: what has the same path and kind and fits 26 stays; an option 26 has not, a property whose scale or type differs (even a number both take) and a key 26 has not take 26's defaults.",
            "kind": "cutDown",
            "bases": [
                "27",
                "26"
            ],
            "rewrite": false,
            "values": {
                "tokens": {
                    "color": {
