{
    "name": "orderingco/ordering-theme-engine",
    "description": "The Ordering.co API's theme engine (version 2 themes) in PHP: the same schema, the same rules, the same answer as the TypeScript package.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ordering",
        "theme",
        "theme-engine",
        "design-tokens",
        "json-schema"
    ],
    "homepage": "https://github.com/Finitless-com/ordering-theme-engine#readme",
    "support": {
        "issues": "https://github.com/Finitless-com/ordering-theme-engine/issues",
        "source": "https://github.com/Finitless-com/ordering-theme-engine"
    },
    "authors": [
        {
            "name": "Ordering, Inc."
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ordering\\ThemeEngine\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ordering\\ThemeEngine\\Tests\\": "php/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
