{
  "name": "@orderingco/ordering-theme-engine",
  "version": "0.3.0",
  "description": "api-core's theme engine (version 2 themes) in TypeScript: the same schema, the same rules, the same answer.",
  "license": "MIT",
  "author": "Ordering, Inc.",
  "keywords": [
    "ordering",
    "theme",
    "theme-engine",
    "design-tokens",
    "json-schema",
    "cli"
  ],
  "homepage": "https://github.com/Finitless-com/ordering-theme-engine#readme",
  "bugs": {
    "url": "https://github.com/Finitless-com/ordering-theme-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finitless-com/ordering-theme-engine.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ordering-theme": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta/theme-schema-1.json": "./meta/theme-schema-1.json"
  },
  "files": [
    "dist",
    "meta"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && node scripts/build-shape-validator.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json && cp src/shape-validator.js dist/ && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync-fixtures": "bash scripts/sync-fixtures.sh",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
